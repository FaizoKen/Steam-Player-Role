DATABASE_URL=postgres://postgres:your_password@localhost:5432/steam_player_role
SESSION_SECRET=your_session_secret
BASE_URL=http://localhost:8088/steam-player-role
LISTEN_ADDR=0.0.0.0:8088
RUST_LOG=steam_player_role=info,tower_http=info
AUTH_GATEWAY_URL=http://localhost:8080
INTERNAL_API_KEY=your_internal_api_key

# Origin allowed to embed the role-config page in an iframe (the RoleLogic
# dashboard). Unset = permissive `*` for dev / self-hosted RoleLogic.
# RL_DASHBOARD_ORIGIN=https://rolelogic.faizo.net

# Steam
STEAM_API_KEY=your_steam_api_key

# Quota governor (see README "Scaling & rate limits")
# Valve's Web API Terms of Use allow 100,000 calls/day per key.
STEAM_API_DAILY_QUOTA=100000
# Fraction of the daily quota kept aside for link-time calls users wait on.
QUOTA_INTERACTIVE_RESERVE=0.20
# Fraction of the nominal quota actually spent (headroom for skew).
QUOTA_SAFETY_FRACTION=0.95
# Background refresh workers (partitioned, never double-process).
REFRESH_WORKERS=2
# Ceiling for long-stable users' stretched refresh interval (seconds).
MAX_STABLE_REFRESH_SECS=604800
